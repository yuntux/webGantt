+            if (window.currentDetailsTaskNode && window.currentDetailsTaskNode.parentNode) {
+                if (confirm("Voulez-vous vraiment supprimer cette tâche ?")) {
+                    window.currentDetailsTaskNode.parentNode.removeChild(window.currentDetailsTaskNode);
+                    state.notifyListeners();
+                    document.getElementById('task-details-modal').close();
+                }
+            }
+        });
+
+        document.getElementById('td-btn-shift').addEventListener('click', () => {
+            if (window.currentDetailsTaskId) {
+                shiftTaskRecursive(window.currentDetailsTaskId, 1);
+                state.notifyListeners();
+                document.getElementById('task-details-modal').close();
+            }
+        });
+
+        document.getElementById('td-btn-assign').addEventListener('click', () => {
+            if (window.currentDetailsTaskId) {
+                const res = getResources();
+                if (res.length === 0) {
+                    alert('Aucune ressource dans le pool. Créez-en d\'abord via le bouton Ressources.');
+                    return;
+                }
+                const assignSelect = document.getElementById('assign-resource-select');
+                assignSelect.innerHTML = '';
+                res.forEach(r => {
+                    const opt = document.createElement('option');
+                    opt.value = r.id;
+                    opt.textContent = r.name;
+                    assignSelect.appendChild(opt);
+                });
+                window.currentAssignTaskId = window.currentDetailsTaskId;
+                document.getElementById('task-details-modal').close();
+                document.getElementById('assign-modal').showModal();
+            }
+        });
+
+        document.getElementById('td-btn-prog').addEventListener('click', () => {
+            if (window.currentDetailsTaskNode) {
+                const currentComp = window.currentDetailsTaskNode.getAttribute('complete') || 0;
+                const val = prompt("Pourcentage d'avancement (0-100) :", currentComp);
+                if (val !== null) {
+                    const parsed = parseInt(val);
+                    if (!isNaN(parsed) && parsed >= 0 && parsed <= 100) {
+                        window.currentDetailsTaskNode.setAttribute('complete', parsed);
+                        state.notifyListeners();
+                        document.getElementById('task-details-modal').close();
+                    } else {
+                        alert("Veuillez entrer un nombre entre 0 et 100.");
+                    }
+                }
+            }
+        });
