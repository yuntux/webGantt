+        // T029 : Gestion de la sélection et UI
+        function updateSelectionUI() {
+            // Mise à jour des lignes WBS
+            document.querySelectorAll('#wbs-content > div').forEach(row => {
+                const id = row.getAttribute('data-task-id');
+                if (window.selectedTaskIds.has(id)) {
+                    row.style.backgroundColor = '#e3f2fd'; // Bleu léger
+                } else {
+                    row.style.backgroundColor = '';
+                }
+            });
+
+            // Mise à jour des éléments du SVG (Gantt)
+            const svgDoc = document.querySelector('#gantt-content svg');
+            if (svgDoc) {
+                svgDoc.querySelectorAll('.gantt-item').forEach(item => {
+                    const id = item.getAttribute('data-task-id');
+                    if (window.selectedTaskIds.has(id)) {
+                        item.setAttribute('stroke', '#ffeb3b'); // Contour jaune pour la sélection
+                        item.setAttribute('stroke-width', '3');
+                    } else {
+                        item.removeAttribute('stroke');
+                        item.removeAttribute('stroke-width');
+                    }
+                });
+            }
+            
+            updateToolbarButtons();
+        }
+
+        // T030 & T031 : Boutons hiérarchie WBS
+        function getPrevTask(node) {
+            let n = node.previousElementSibling;
+            while(n && n.tagName !== 'task') n = n.previousElementSibling;
+            return n;
+        }
+        function getNextTask(node) {
+            let n = node.nextElementSibling;
+            while(n && n.tagName !== 'task') n = n.nextElementSibling;
+            return n;
+        }
+
+        function updateToolbarButtons() {
+            const btnIndent = document.getElementById('btn-indent');
+            const btnOutdent = document.getElementById('btn-outdent');
+            const btnUp = document.getElementById('btn-move-up');
+            const btnDown = document.getElementById('btn-move-down');
+            const btnLink = document.getElementById('btn-link');
+            const btnUnlink = document.getElementById('btn-unlink');
+            
+            const selected = Array.from(window.selectedTaskIds);
+            
+            if (selected.length !== 1) {
+                btnIndent.disabled = true;
+                btnOutdent.disabled = true;
+                btnUp.disabled = true;
+                btnDown.disabled = true;
+                
+                // Chaînage
+                if (selected.length >= 2) {
+                    const parentNames = new Set(selected.map(id => {
+                        const n = state.xmlDoc.querySelector(`task[id="${id}"]`);
+                        return n && n.parentNode ? n.parentNode.nodeName : 'NONE'; // Approximatif pour l'instant
+                    }));
+                    btnLink.disabled = parentNames.size !== 1;
+                    btnUnlink.disabled = false; // Autorisé s'il y a des liens
+                } else {
+                    btnLink.disabled = true;
+                    btnUnlink.disabled = true;
+                }
+                return;
+            }
+            
+            btnLink.disabled = true;
+            btnUnlink.disabled = true;
+            
+            const taskNode = state.xmlDoc.querySelector(`task[id="${selected[0]}"]`);
+            if (!taskNode) return;
+            
+            btnIndent.disabled = !getPrevTask(taskNode);
+            btnOutdent.disabled = (taskNode.parentNode.tagName !== 'task');
+            btnUp.disabled = !getPrevTask(taskNode);
+            btnDown.disabled = !getNextTask(taskNode);
+        }
+
+        // Événements d'indentation / déplacement
+        document.getElementById('btn-indent').addEventListener('click', () => {
+            const taskId = Array.from(window.selectedTaskIds)[0];
+            const node = state.xmlDoc.querySelector(`task[id="${taskId}"]`);
+            const prev = getPrevTask(node);
+            if (prev) {
+                prev.appendChild(node);
+                state.notifyListeners();
+            }
+        });
+
+        document.getElementById('btn-outdent').addEventListener('click', () => {
+            const taskId = Array.from(window.selectedTaskIds)[0];
+            const node = state.xmlDoc.querySelector(`task[id="${taskId}"]`);
+            const parent = node.parentNode;
+            if (parent && parent.tagName === 'task') {
+                parent.parentNode.insertBefore(node, parent.nextElementSibling);
+                state.notifyListeners();
+            }
+        });
+
+        document.getElementById('btn-move-up').addEventListener('click', () => {
+            const taskId = Array.from(window.selectedTaskIds)[0];
+            const node = state.xmlDoc.querySelector(`task[id="${taskId}"]`);
+            const prev = getPrevTask(node);
+            if (prev) {
+                node.parentNode.insertBefore(node, prev);
+                state.notifyListeners();
+            }
+        });
+
+        document.getElementById('btn-move-down').addEventListener('click', () => {
+            const taskId = Array.from(window.selectedTaskIds)[0];
+            const node = state.xmlDoc.querySelector(`task[id="${taskId}"]`);
+            const next = getNextTask(node);
+            if (next) {
+                node.parentNode.insertBefore(next, node);
+                state.notifyListeners();
+            }
+        });
+
